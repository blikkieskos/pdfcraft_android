{
  "build": {
    "beforeBuildCommand": "node scripts/build-android-web.mjs"
  },
  "app": {
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    }
  }
}
